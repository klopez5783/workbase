rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // 🔥 CRITICAL: This MUST come BEFORE the helper function is used
    // This MUST allow authenticated reads (no isAdmin check here!)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Now isAdmin() will work for other collections
    match /workers/{workerId} {
    allow read: if true; // ✅ Allows anyone to read (needed for access key lookup)
    allow create, update, delete: if isAdmin();
  }
    
    match /projects/{projectId} {
    // Allow public read for workers (including non-authenticated workers using access keys)
    // This is needed for geofencing and clock-in functionality
    allow read: if true;
    // Admins can only create projects (createdBy will be set to their uid)
    allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
    // Admins can only update/delete their own projects
    allow update, delete: if isAdmin() && resource.data.createdBy == request.auth.uid;
  }
    
    match /employees/{employeeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    match /timeEntries/{entryId} {
      allow create: if true;  // Public worker clock-in
      allow read, update, delete: if isAdmin();
    }
    
    // Fallback for other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}